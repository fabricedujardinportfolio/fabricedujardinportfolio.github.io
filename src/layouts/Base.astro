---
import '@fontsource-variable/inter';
import '@fontsource-variable/outfit';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import profile from '../data/profile.json';

import experiences from '../data/experiences.json';
import formations from '../data/formations.json';
import skills from '../data/skills.json';

interface Props {
  title: string;
  description: string;
  /** Chemin d'une image OG (par défaut : le portrait). */
  image?: string;
  type?: 'website' | 'article' | 'profile';
  /** Schémas JSON-LD supplémentaires propres à la page (FAQ, fil d'Ariane, projet…). */
  schemas?: Record<string, unknown>[];
  /** Fil d'Ariane : [{ name, path }] ; l'accueil est ajouté automatiquement. */
  crumbs?: { name: string; path: string }[];
}
const { title, description, image = '/og-image.png', type = 'website', schemas = [], crumbs = [] } = Astro.props;
const siteUrl = Astro.site!.toString().replace(/\/$/, '');
const current = experiences.find((e) => e.end === null);
const knows = skills.flatMap((g) => g.items);
const fullName = `${profile.firstName} ${profile.lastName}`;
const pageTitle = title === fullName ? `${fullName} — ${profile.title} à Nouméa, Nouvelle-Calédonie` : `${title} · ${fullName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const person = {
  '@type': 'Person',
  '@id': `${siteUrl}/#person`,
  name: fullName,
  givenName: profile.firstName,
  familyName: profile.lastName,
  jobTitle: profile.title,
  description: `${profile.title} à Nouméa, Nouvelle-Calédonie. ${profile.tagline}`,
  url: `${siteUrl}/`,
  image: ogImage.toString(),
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Nouméa', addressRegion: 'Province Sud', addressCountry: 'NC' },
  homeLocation: { '@type': 'Place', name: profile.seo.geo.placename, geo: { '@type': 'GeoCoordinates', latitude: profile.seo.geo.lat, longitude: profile.seo.geo.lng } },
  nationality: { '@type': 'Country', name: 'France' },
  sameAs: Object.values(profile.links).filter(Boolean),
  knowsAbout: knows,
  knowsLanguage: profile.languages.map((l) => l.name),
  hasOccupation: {
    '@type': 'Occupation',
    name: profile.title,
    occupationLocation: { '@type': 'City', name: 'Nouméa' },
    skills: knows.join(', '),
    experienceRequirements: profile.conditions.experienceYears,
    estimatedSalary: {
      '@type': 'MonetaryAmountDistribution',
      name: 'Prétentions salariales (CDI temps plein)',
      currency: 'XPF',
      duration: 'P1M',
      minValue: 300000,
    },
  },
  worksFor: current && { '@type': 'Organization', name: current.company, location: current.location },
  alumniOf: formations.filter((f) => /diplôme|titre/i.test(f.level + f.title)).map((f) => ({ '@type': 'EducationalOrganization', name: f.school })),
  seeks: { '@type': 'Demand', name: profile.conditions.openTo, areaServed: { '@type': 'Country', name: 'Nouvelle-Calédonie' } },
};
const website = {
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: `${siteUrl}/`,
  name: `${fullName} — ${profile.title} à Nouméa`,
  description: profile.tagline,
  inLanguage: 'fr',
  author: { '@id': `${siteUrl}/#person` },
  publisher: { '@id': `${siteUrl}/#person` },
};
const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [{ name: 'Accueil', path: '/' }, ...crumbs].map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: `${siteUrl}${c.path}`,
  })),
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [person, website, ...(crumbs.length ? [breadcrumb] : []), ...schemas],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0b0e14" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f6fa" media="(prefers-color-scheme: light)" />
    <meta name="author" content={fullName} />
    <meta name="keywords" content={profile.seo.keywords.join(', ')} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="geo.region" content={profile.seo.geo.region} />
    <meta name="geo.placename" content={profile.seo.geo.placename} />
    <meta name="geo.position" content={`${profile.seo.geo.lat};${profile.seo.geo.lng}`} />
    <meta name="ICBM" content={`${profile.seo.geo.lat}, ${profile.seo.geo.lng}`} />
    <meta name="google-site-verification" content="6AI9TGppZAHmw_rKPYqiZLSlBS03iZc_hd_HuwY2K0U" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={fullName} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`Portrait de ${fullName}`} />
    <meta property="profile:first_name" content={profile.firstName} />
    <meta property="profile:last_name" content={profile.lastName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline src="/theme-init.js"></script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
