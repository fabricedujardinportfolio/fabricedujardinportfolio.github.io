---
import { Image } from 'astro:assets';
import { logo } from '../lib/images';
interface Props {
  name: string | null | undefined;
  label: string;
  size?: number;
}
const { name, label, size = 48 } = Astro.props;
const img = await logo(name);
const initials = label
  .replace(/[^\p{L}\s-]/gu, '')
  .split(/[\s-]+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0]?.toUpperCase())
  .join('');
---

<span class="org-logo" data-size={size}>
  {img ? <Image src={img} alt={`Logo ${label}`} width={size * 2} height={size * 2} densities={undefined} /> : <span class="avatar-fallback" aria-hidden="true">{initials}</span>}
</span>

<style>
  .org-logo {
    flex: none;
    display: block;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--border);
  }
  .org-logo[data-size='40'] { width: 40px; height: 40px; border-radius: 10px; }
  .org-logo[data-size='56'] { width: 56px; height: 56px; border-radius: 14px; }
  .org-logo img { width: 100%; height: 100%; object-fit: contain; padding: 4px; }
  .org-logo .avatar-fallback { font-size: 0.9rem; }
</style>
