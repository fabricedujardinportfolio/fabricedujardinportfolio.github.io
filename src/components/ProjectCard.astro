---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { projectImage } from '../lib/images';

interface Props {
  project: {
    slug: string;
    title: string;
    category: string;
    year: number;
    summary: string;
    stack: string[];
    cover: string;
  };
  loading?: 'eager' | 'lazy';
}
const { project, loading = 'lazy' } = Astro.props;
const cover = await projectImage(project.cover);
---

<article class="project-card card card--hover filterable reveal" data-cat={project.category}>
  <a class="project-card__media" href={`/projets/${project.slug}/`} tabindex="-1" aria-hidden="true">
    {cover && <Image src={cover} alt="" width={720} widths={[420, 720]} sizes="(max-width: 700px) 92vw, 33vw" loading={loading} />}
    <span class="project-card__cat chip chip--accent">{project.category}</span>
  </a>
  <div class="project-card__body">
    <p class="project-card__meta mono">{project.year} · GIEP-NC</p>
    <h3><a href={`/projets/${project.slug}/`}>{project.title}</a></h3>
    <p class="project-card__summary">{project.summary}</p>
    <ul class="chips" aria-label="Technologies">
      {project.stack.slice(0, 4).map((s) => <li class="chip">{s}</li>)}
    </ul>
    <a class="link-arrow project-card__more" href={`/projets/${project.slug}/`}>
      Voir le projet <Icon name="arrow" />
    </a>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }
  .project-card__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
  }
  .project-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.8s var(--ease);
  }
  .project-card:hover .project-card__media img { transform: scale(1.04); }
  .project-card__cat { position: absolute; top: 12px; left: 12px; backdrop-filter: blur(6px); }
  .project-card__body { display: flex; flex-direction: column; gap: 10px; padding: 22px; flex: 1; }
  .project-card__meta { margin: 0; color: var(--faint); font-size: 0.8rem; }
  .project-card h3 { margin: 0; }
  .project-card h3 a { color: var(--text); }
  .project-card h3 a::after { content: ''; position: absolute; inset: 0; }
  .project-card__summary { margin: 0; color: var(--muted); flex: 1; }
  .project-card__more { position: relative; z-index: 1; margin-top: 6px; }
</style>
